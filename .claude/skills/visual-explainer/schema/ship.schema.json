{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-explainer/ship.schema.json",
  "title": "visual-explainer ship props",
  "description": "What shipped: each Done when result, deviations, setbacks, the review verdict and findings, a hand-test checklist and rollback steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "meta", "summary", "delivered", "deviations", "reviews", "handTest", "rollback"],
  "properties": {
    "mode": { "const": "ship" },
    "meta": { "$ref": "#/$defs/meta" },
    "summary": { "$ref": "#/$defs/text" },
    "changes": {
      "description": "Optional how-and-why rows for the main changes.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "how", "why"],
        "properties": {
          "area": { "$ref": "#/$defs/label" },
          "how": { "$ref": "#/$defs/text" },
          "why": { "$ref": "#/$defs/text" }
        }
      }
    },
    "delivered": {
      "description": "One row for each Done when criterion.",
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "result", "status"],
        "properties": {
          "phase": { "type": "integer", "minimum": 0 },
          "criterion": { "$ref": "#/$defs/text" },
          "result": { "$ref": "#/$defs/text" },
          "status": { "enum": ["met", "partial", "missed"] }
        }
      }
    },
    "deviations": {
      "description": "Each place where the result differs from the plan. Use an empty array when there is none.",
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planned", "actual", "reason"],
        "properties": {
          "planned": { "$ref": "#/$defs/text" },
          "actual": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" }
        }
      }
    },
    "process": {
      "description": "Optional process numbers of the work. In a Loop run, copy them from loop-retro.mjs totals. Omit a number that you do not know.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phases": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "escalations": { "type": "integer", "minimum": 0 },
        "questions": { "type": "integer", "minimum": 0 },
        "hil": { "type": "integer", "minimum": 0 },
        "mergeConflicts": { "type": "integer", "minimum": 0 },
        "reviewRounds": { "type": "integer", "minimum": 0 },
        "fixRounds": { "type": "integer", "minimum": 0 },
        "wallTime": { "$ref": "#/$defs/label" }
      }
    },
    "setbacks": {
      "description": "Optional process costs, also when the result matches the plan. A deviation is a different result. A setback is a cost on the way to the result.",
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "what", "resolution"],
        "properties": {
          "phase": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["retry", "verify-fail", "timeout", "rate-limit", "model-escalation", "question", "hil", "merge-conflict", "review-round", "review-dispute", "replan", "environment", "other"] },
          "title": { "$ref": "#/$defs/label" },
          "what": { "$ref": "#/$defs/text" },
          "cost": { "$ref": "#/$defs/label" },
          "resolution": { "$ref": "#/$defs/text" },
          "lesson": { "$ref": "#/$defs/text" }
        }
      }
    },
    "reviews": {
      "description": "One entry for each reviewed repository or PR.",
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/review" }
    },
    "handTest": {
      "description": "Ordered commands for a human. Each command has a code reference that proves the command and its position.",
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "ref", "why"],
        "properties": {
          "title": { "$ref": "#/$defs/label" },
          "command": { "$ref": "#/$defs/command" },
          "ref": { "$ref": "#/$defs/codeRef" },
          "why": { "$ref": "#/$defs/text" },
          "expect": { "$ref": "#/$defs/text" }
        }
      }
    },
    "rollback": {
      "description": "Ordered steps that undo the change.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step"],
        "properties": {
          "step": { "$ref": "#/$defs/text" },
          "command": { "$ref": "#/$defs/command" },
          "ref": { "$ref": "#/$defs/codeRef" }
        }
      }
    }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s\"'<>]+$",
      "description": "an absolute http or https URL"
    },
    "codeRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:)?[^\\s:]+:[1-9][0-9]*(?:-[1-9][0-9]*)?$",
      "description": "path:line or path:start-end, relative to the repository root, with an optional owner/repo: prefix"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "date"],
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^\\S+(?: \\S+){1,3}$",
          "maxLength": 60,
          "description": "2 to 4 words separated by single spaces"
        },
        "subtitle": { "$ref": "#/$defs/text" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
        "planId": { "$ref": "#/$defs/label" },
        "milestone": { "type": "integer", "minimum": 1 },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": { "label": { "$ref": "#/$defs/label" }, "url": { "$ref": "#/$defs/url" } }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "summary", "validation", "findings"],
      "properties": {
        "repository": { "$ref": "#/$defs/label" },
        "pr": { "$ref": "#/$defs/url" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "a commit SHA" },
        "verdict": { "enum": ["APPROVE", "COMMENT", "REQUEST_CHANGES"] },
        "url": { "$ref": "#/$defs/url" },
        "summary": { "$ref": "#/$defs/text" },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result"],
            "properties": {
              "command": { "$ref": "#/$defs/command" },
              "result": { "enum": ["pass", "fail", "skipped"] },
              "note": { "$ref": "#/$defs/text" }
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "title", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,16}$", "description": "a short ID such as F4" },
              "severity": { "enum": ["blocker", "major", "minor", "nit", "style"] },
              "title": { "$ref": "#/$defs/text" },
              "location": { "$ref": "#/$defs/label" },
              "detail": { "$ref": "#/$defs/text" },
              "fix": { "$ref": "#/$defs/text" },
              "status": { "enum": ["open", "fixed", "deferred"] }
            }
          }
        },
        "split": { "$ref": "#/$defs/text" }
      }
    }
  }
}
