{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-explainer/ship.schema.json",
  "title": "visual-explainer ship props",
  "description": "What shipped: each Done when result, deviations, setbacks, the review verdict and findings, a hand-test checklist and rollback steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "meta", "summary", "delivered", "deviations", "reviews", "handTest", "rollback"],
  "properties": {
    "mode": { "const": "ship" },
    "meta": { "$ref": "#/$defs/meta" },
    "summary": { "$ref": "#/$defs/text" },
    "tldr": {
      "description": "Optional TL;DR callout at the top of the report. Without it, the report uses the summary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["changed"],
      "properties": {
        "changed": { "$ref": "#/$defs/text" },
        "lookFirst": { "$ref": "#/$defs/text", "description": "What a reviewer reads first." },
        "risk": { "$ref": "#/$defs/text" }
      }
    },
    "stats": {
      "description": "Optional diff size for the report header: +additions −deletions across files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "additions", "deletions"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "media": { "$ref": "#/$defs/media" },
    "changes": {
      "description": "Optional how-and-why rows for the main changes.",
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "how", "why"],
        "properties": {
          "area": { "$ref": "#/$defs/label" },
          "how": { "$ref": "#/$defs/text" },
          "why": { "$ref": "#/$defs/text" },
          "phases": { "$ref": "#/$defs/phaseRefs", "description": "Relation: the phases that built the change." },
          "files": {
            "description": "Optional file rows of the change card.",
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "additions", "deletions"],
              "properties": {
                "path": { "$ref": "#/$defs/label" },
                "additions": { "type": "integer", "minimum": 0 },
                "deletions": { "type": "integer", "minimum": 0 },
                "note": { "$ref": "#/$defs/label" }
              }
            }
          },
          "sequence": {
            "description": "Optional sequence diagram of the change. At most one change has a sequence: the change where the interactions changed.",
            "type": "object",
            "additionalProperties": false,
            "required": ["participants", "messages"],
            "properties": {
              "participants": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                    "status": { "enum": ["new", "changed", "existing"] }
                  }
                }
              },
              "messages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 14,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to", "label"],
                  "properties": {
                    "from": { "type": "string", "minLength": 1, "maxLength": 40, "description": "The name of a participant." },
                    "to": { "type": "string", "minLength": 1, "maxLength": 40, "description": "The name of a participant." },
                    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "kind": { "enum": ["call", "return", "self"], "description": "Default call. A self message has from equal to to." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "delivered": {
      "description": "One row for each Done when criterion.",
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "result", "status"],
        "properties": {
          "phase": { "type": "integer", "minimum": 0 },
          "criterion": { "$ref": "#/$defs/text" },
          "result": { "$ref": "#/$defs/text" },
          "status": { "enum": ["met", "partial", "missed", "pending"], "description": "pending: the phase is not done yet (checkpoint reports only)." }
        }
      }
    },
    "deviations": {
      "description": "Each place where the result differs from the plan. Use an empty array when there is none.",
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planned", "actual", "reason"],
        "properties": {
          "planned": { "$ref": "#/$defs/text" },
          "actual": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" },
          "phases": { "$ref": "#/$defs/phaseRefs", "description": "Relation: the phases that the deviation concerns." }
        }
      }
    },
    "process": {
      "description": "Optional process numbers of the work. In a Loop run, copy them from loop-retro.mjs totals. Omit a number that you do not know.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phases": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "escalations": { "type": "integer", "minimum": 0 },
        "questions": { "type": "integer", "minimum": 0 },
        "hil": { "type": "integer", "minimum": 0 },
        "mergeConflicts": { "type": "integer", "minimum": 0 },
        "reviewRounds": { "type": "integer", "minimum": 0 },
        "fixRounds": { "type": "integer", "minimum": 0 },
        "wallTime": { "$ref": "#/$defs/label" }
      }
    },
    "setbacks": {
      "description": "Optional process costs, also when the result matches the plan. A deviation is a different result. A setback is a cost on the way to the result.",
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "what", "resolution"],
        "properties": {
          "phase": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["retry", "verify-fail", "timeout", "rate-limit", "model-escalation", "question", "hil", "merge-conflict", "review-round", "review-dispute", "replan", "environment", "other"] },
          "title": { "$ref": "#/$defs/label" },
          "what": { "$ref": "#/$defs/text" },
          "cost": { "$ref": "#/$defs/label" },
          "resolution": { "$ref": "#/$defs/text" },
          "lesson": { "$ref": "#/$defs/text" }
        }
      }
    },
    "reviews": {
      "description": "One entry for each reviewed repository or PR. At least one, except in a checkpoint report (meta.checkpoint), where it may be empty.",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/review" }
    },
    "handTest": {
      "description": "Ordered commands for a human. Each command has a code reference that proves the command and its position.",
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "ref", "why"],
        "properties": {
          "title": { "$ref": "#/$defs/label" },
          "command": { "$ref": "#/$defs/command" },
          "ref": { "$ref": "#/$defs/codeRef" },
          "why": { "$ref": "#/$defs/text" },
          "expect": { "$ref": "#/$defs/text" },
          "phases": { "$ref": "#/$defs/phaseRefs", "description": "Relation: the phases that the step checks." }
        }
      }
    },
    "rollback": {
      "description": "Ordered steps that undo the change.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step"],
        "properties": {
          "step": { "$ref": "#/$defs/text" },
          "command": { "$ref": "#/$defs/command" },
          "ref": { "$ref": "#/$defs/codeRef" }
        }
      }
    }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "phaseRefs": {
      "description": "Relation: phase numbers. Each number must be the phase of a delivered row.",
      "type": "array",
      "maxItems": 40,
      "items": { "type": "integer", "minimum": 0 }
    },
    "changeRefs": {
      "description": "Relation: change areas. Each area must be the exact area of one changes item.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/label" }
    },
    "facts": {
      "description": "Optional label and value pairs under the report title. A value in backticks shows as code.",
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 40 }, "value": { "$ref": "#/$defs/label" } }
      }
    },
    "media": {
      "description": "Optional screenshots. The report inlines each image. Figures without a change show in a Screenshots block after the changes section.",
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "caption"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:png|jpg|jpeg|webp|gif)$",
            "description": "a relative path from the directory of the props file to a .png, .jpg, .jpeg, .webp or .gif file, with no \"..\" segment"
          },
          "caption": { "$ref": "#/$defs/text" },
          "section": { "$ref": "#/$defs/label", "description": "Reserved. Omit it." },
            "change": { "$ref": "#/$defs/label", "description": "Relation: the exact area of one change. The figure shows inside that change card." }
        }
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s\"'<>]+$",
      "description": "an absolute http or https URL"
    },
    "codeRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:)?[^\\s:]+:[1-9][0-9]*(?:-[1-9][0-9]*)?$",
      "description": "path:line or path:start-end, relative to the repository root, with an optional owner/repo: prefix"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "date"],
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^\\S+(?: \\S+){1,3}$",
          "maxLength": 60,
          "description": "2 to 4 words separated by single spaces"
        },
        "subtitle": { "$ref": "#/$defs/text" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
        "planId": { "$ref": "#/$defs/label" },
        "milestone": { "type": "integer", "minimum": 1 },
        "facts": { "$ref": "#/$defs/facts" },
        "checkpoint": {
          "description": "Optional: this report is a progress checkpoint in the middle of a milestone, not the merge gate.",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "phasesDone", "phasesTotal"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "phasesDone": { "type": "integer", "minimum": 0 },
            "phasesTotal": { "type": "integer", "minimum": 1 },
            "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$", "description": "YYYY-MM-DD HH:MM, the start of the period that this checkpoint covers" }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": { "label": { "$ref": "#/$defs/label" }, "url": { "$ref": "#/$defs/url" } }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "summary", "validation", "findings"],
      "properties": {
        "repository": { "$ref": "#/$defs/label" },
        "pr": { "$ref": "#/$defs/url" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "a commit SHA" },
        "verdict": { "enum": ["APPROVE", "COMMENT", "REQUEST_CHANGES"] },
        "url": { "$ref": "#/$defs/url" },
        "summary": { "$ref": "#/$defs/text" },
        "validation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result"],
            "properties": {
              "command": { "$ref": "#/$defs/command" },
              "result": { "enum": ["pass", "fail", "skipped"] },
              "note": { "$ref": "#/$defs/text" }
            }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "title", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,16}$", "description": "a short ID such as F4" },
              "severity": { "enum": ["blocker", "major", "minor", "nit", "style"] },
              "title": { "$ref": "#/$defs/text" },
              "location": { "$ref": "#/$defs/label" },
              "detail": { "$ref": "#/$defs/text" },
              "fix": { "$ref": "#/$defs/text" },
              "status": { "enum": ["open", "fixed", "deferred"] },
              "phases": { "$ref": "#/$defs/phaseRefs", "description": "Relation: the phases that the finding is about." },
              "changes": { "$ref": "#/$defs/changeRefs", "description": "Relation: the changes that the finding is about." }
            }
          }
        },
        "split": { "$ref": "#/$defs/text" }
      }
    }
  }
}
