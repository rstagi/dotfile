[Unit]
Description=ws hub (mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ws-hub
Group=ws-hub
# systemd (root) reads the certbot files. The service user cannot.
LoadCredential=tls-cert:/etc/letsencrypt/live/@DOMAIN@/fullchain.pem
LoadCredential=tls-key:/etc/letsencrypt/live/@DOMAIN@/privkey.pem
ExecStart=/usr/local/bin/ws hub serve --listen 0.0.0.0:443 --tls-cert %d/tls-cert --tls-key %d/tls-key --ca-cert /etc/ws-hub/root-ca.pem --state /var/lib/ws-hub
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ws-hub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
