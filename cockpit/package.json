{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local agent cockpit event store and intent engine",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
